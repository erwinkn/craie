{
  "format": "craie-list-trace/1",
  "id": "L4",
  "name": "a pending load is asked again after a batch that reaches its rows, not after one elsewhere",
  "viewport": {
    "width": 400,
    "height": 400
  },
  "config": {
    "overscan": 600,
    "lookahead": 400,
    "endThreshold": 80,
    "anchor": "start",
    "anchorPolicy": "reading"
  },
  "templates": [],
  "items": [
    {
      "count": 20,
      "key": "m{i}",
      "loaded": false,
      "estimate": 40
    },
    {
      "count": 80,
      "key": "m{i}",
      "estimate": 40,
      "height": 40
    }
  ],
  "steps": [
    {
      "do": "mount",
      "expect": {
        "visible": [
          0,
          9
        ],
        "load": [
          0,
          19
        ]
      }
    },
    {
      "do": "changes",
      "changes": [
        {
          "kind": "update",
          "at": 99,
          "items": [
            {
              "count": 1,
              "key": "m{i}",
              "version": 1,
              "estimate": 40,
              "height": 40
            }
          ]
        }
      ],
      "expect": {
        "load": null
      }
    },
    {
      "do": "changes",
      "changes": [
        {
          "kind": "update",
          "at": 0,
          "items": [
            {
              "count": 5,
              "key": "m{i}",
              "version": 1,
              "estimate": 40,
              "height": 40
            }
          ]
        }
      ],
      "expect": {
        "load": [
          5,
          19
        ],
        "held": [
          0,
          4
        ]
      }
    }
  ]
}
