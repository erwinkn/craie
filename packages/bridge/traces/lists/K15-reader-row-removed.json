{
  "format": "craie-list-trace/1",
  "id": "K15",
  "name": "removing the reader's row holds the first visible row that stays",
  "viewport": {
    "width": 400,
    "height": 200
  },
  "config": {
    "overscan": 600,
    "lookahead": 200,
    "endThreshold": 80,
    "anchor": "start",
    "anchorPolicy": "reading"
  },
  "templates": [],
  "items": [
    {
      "count": 100,
      "key": "m{i}",
      "estimate": 40,
      "height": 40
    }
  ],
  "steps": [
    {
      "do": "mount"
    },
    {
      "do": "scroll",
      "offset": 1000,
      "expect": {
        "anchor": {
          "key": "m25",
          "offset": 0
        }
      }
    },
    {
      "do": "changes",
      "changes": [
        {
          "kind": "splice",
          "at": 24,
          "remove": 2,
          "items": []
        }
      ],
      "expect": {
        "anchor": {
          "key": "m26",
          "offset": 40
        },
        "offset": 920,
        "visible": [
          23,
          27
        ]
      }
    }
  ]
}
