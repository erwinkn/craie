    },
    {
      "count": 199,
      "key": "m{i}",
      "estimate": 40,
      "height": 40
    }
  ],
  "steps": [
    {
      "do": "mount",
      "expect": {
        "visible": [
          0,
          13
        ]
      }
    },
    {
      "do": "scrollToIndex",
      "index": 100,
      "align": "start",
      "expect": {
        "anchor": {
          "key": "m100",
          "offset": 0
