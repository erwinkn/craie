  "steps": [
    {
      "do": "mount",
      "expect": {
        "visible": [
          0,
          5
        ]
      }
    },
    {
      "do": "scrollToIndex",
      "index": 100,
      "align": "start",
      "expect": {
        "anchor": {
          "key": "m100",
          "offset": 0
        },
        "visible": [
          100,
          105
        ]
      }
    },
    {
      "do": "scrollToIndex",
      "index": 150,
      "align": "center",
      "expect": {
        "anchor": {
          "key": "m150",
          "offset": 250
        },
        "visible": [
          147,
          153
        ]
      }
    }
  ]
}
